<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <OutputType Condition="$(RuntimeIdentifier.StartsWith('win'))">WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Modzarella</AssemblyName>
    <Version>1.3.1</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <ApplicationIcon>../../assets/branding/icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
    <RuntimeHostConfigurationOption Include="System.GC.RetainVM" Value="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Photino.NET" Version="4.0.16" />
    <EmbeddedResource Include="Web/ui.*" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../assets/theme.css" LogicalName="theme.css" />
    <EmbeddedResource Include="Runtime/*.dll" LogicalName="runtime/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
